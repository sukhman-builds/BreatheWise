# Port for the Express server
PORT=5000

# OpenAQ API v3 Key (Get one from https://openaq.org/)
OPENAQ_API_KEY=your_openaq_api_key_here

# Allowed CORS origins, comma-separated (e.g. http://localhost:5173,https://your-app.vercel.app)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: OpenAQ fetch timeout in milliseconds (default: 10000)
OPENAQ_TIMEOUT_MS=10000
